# Folio — variables (todas opcionales en la app de Mac).
# La app (Folio.app) no necesita ninguna: trae su propio Postgres.
# Solo para correr `folio serve` contra un Postgres propio:

# ── Base de datos ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=folio
DB_PASS=
DB_NAME=folio
DB_SSLMODE=disable

# ── Servidor HTTP (`folio serve`) ───────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=:8080

# ── Datos y tareas ──────────────────────────────────────────
# Carpeta de los PDF de fondos fuera del modo app (por defecto ./data).
FOLIO_DATA_DIR=
# Zona horaria del cron (por defecto America/Puerto_Rico).
FOLIO_TZ=
# Páginas/PDF por corrida del crawler (por defecto 500 el cron, 400 el botón).
FOLIO_CRAWL_BUDGET=

# ── Pruebas ─────────────────────────────────────────────────
# FOLIO_NO_BROWSER=1   no abre navegador ni diálogos
# FOLIO_PG_BIN=        binarios de Postgres (por defecto los de dentro del .app)

# ── Usuarios ────────────────────────────────────────────────
# No hay usuario por defecto:
#   FOLIO_PASSWORD='...' ./folio user add persona@org.org admin
#   ./folio user list
