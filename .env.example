# Folio — un solo binario (HTTP + cron), sin IA
# Copy this file to .env and fill in production values.
#
#   cp .env.example .env
#   vim .env

# ── Database (PostgreSQL + pgvector) ─────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=folio
DB_PASS=folio_dev
DB_NAME=folio
DB_SSLMODE=disable

# ── Server ───────────────────────────────────────────────────
SERVER_PORT=:8080
SERVER_HOST=

# ── Usuarios ────────────────────────────────────────────────
# No hay usuario por defecto. Créalos con el binario:
#   FOLIO_PASSWORD='...' ./folio user add persona@org.org admin
#   ./folio user list

# ── S3-Compatible Object Storage (Oracle Object Storage) ─────
# Used for archiving article evidence (PDFs, screenshots).
# Leave blank to disable evidence archival.
S3_ENDPOINT=
S3_BUCKET=folio-evidence
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-ashburn-1

# ── Caddy / Domain ──────────────────────────────────────────
# Set to your DuckDNS subdomain or custom domain for production.
# Caddy will auto-provision HTTPS via Let's Encrypt.
# Leave as localhost for local development.
DOMAIN=localhost
