---
import Layout from '../layouts/Layout.astro';
import InboxFeed from '../islands/InboxFeed';
---

<Layout title="Inbox" activeNav="inbox">
  <div class="space-y-5">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <h1 class="title-xl">Inbox</h1>
      <span id="inbox-count" class="tag tag-accent !text-sm !px-3.5 !py-1.5">...</span>
    </div>

    <InboxFeed client:load />

    <div class="hidden lg:flex items-center justify-center gap-5 pt-6 pb-2 text-sm font-semibold text-on-surface-variant" aria-label="Atajos de teclado">
      <span class="inline-flex items-center gap-2"><kbd>J</kbd>Bajar</span>
      <span class="inline-flex items-center gap-2"><kbd>K</kbd>Subir</span>
      <span class="inline-flex items-center gap-2"><kbd>S</kbd>Guardar</span>
      <span class="inline-flex items-center gap-2"><kbd>T</kbd>Borrar</span>
      <span class="inline-flex items-center gap-2"><kbd>P</kbd>Fijar</span>
    </div>
  </div>
</Layout>
